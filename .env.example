# 复制本文件为 .env 后填写真实配置（.env 不会进入代码仓库）
# ---------------- 大模型接口（OpenAI 兼容的 /chat/completions）----------------
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.5
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_MS=180000

# ---------------- 企业信息数据源（可选，留空则跳过并提示人工复核）----------------
# 接口接收 POST {company}，返回 { registration:{}, annualReports:[], creditA:[], abnormal:[] }
ENTERPRISE_API_URL=
ENTERPRISE_API_TOKEN=

# ---------------- 审查报告同步（可选，如飞书机器人 webhook）----------------
REPORT_WEBHOOK_URL=
